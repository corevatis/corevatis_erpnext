  {
   "fieldname": "nachfass_mail_aktiv",
   "fieldtype": "Check",
   "label": "Queue Follow-up Email",
   "default": "0",
   "description": "Puts a follow-up email to the quotation contact into the email queue. Without an outgoing email account nothing is sent (status Not Sent)."
  },
  {
   "fieldname": "nachfass_email_template",
   "fieldtype": "Link",
   "label": "Email Template",
   "options": "Email Template",
