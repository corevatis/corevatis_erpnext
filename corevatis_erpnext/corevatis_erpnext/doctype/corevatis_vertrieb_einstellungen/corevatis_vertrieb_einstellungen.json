   "fieldname": "nachfassen_section",
   "fieldtype": "Section Break",
   "label": "Quotation Follow-up"
  },
  {
   "fieldname": "nachfass_aktiv",
   "fieldtype": "Check",
   "label": "Automatic Follow-up",
   "default": "1",
   "description": "Daily job: creates a follow-up task for submitted, open quotations without answer."
  },
  {
   "fieldname": "nachfass_tage",
   "fieldtype": "Int",
   "label": "Follow-up after (Days)",
   "default": "7",
   "non_negative": 1,
   "description": "Days after the quotation date (and after the previous follow-up task was closed)."
  },
  {
   "fieldname": "nachfass_zyklen",
   "fieldtype": "Int",
   "label": "Maximum Follow-ups per Quotation",
   "default": "2",
   "non_negative": 1
  },
  {
   "fieldname": "nachfass_abgelaufene",
   "fieldtype": "Check",
   "label": "Also Expired Quotations",
   "default": "0",
   "description": "Also follow up quotations whose validity (Valid Till) has passed."
  },
  {
   "fieldname": "column_break_zuweisung",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "nachfass_zuweisung",
   "fieldtype": "Select",
   "label": "Assign Follow-up to",
   "options": "Rolle Büro\nBenutzer",
   "default": "Rolle Büro",
   "description": "Rolle Büro: one task for the creator of the quotation (any active user except Administrator), otherwise for the first active user with the role Büro."
  },
  {
   "fieldname": "nachfass_benutzer",
   "fieldtype": "Link",
   "label": "Follow-up User",
   "options": "User",
   "depends_on": "eval:doc.nachfass_zuweisung=='Benutzer'",
