   "reqd": 1,
   "description": "Invoices and payments: sales invoices, credit notes and payment entries. All postings: every general ledger entry of the period (journal entries, purchase invoices)"
  },
  {
   "fieldname": "festschreibung",
   "fieldtype": "Check",
   "label": "Lock Postings (Festschreibung)",
   "default": "0",
