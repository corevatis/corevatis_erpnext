  },
  {
   "fieldname": "nur_neue",
   "fieldtype": "Check",
   "label": "Only Vouchers Not Exported Yet",
   "default": "0",
   "description": "Skip vouchers that an earlier export already contained (otherwise they are exported again and listed as repeated)"
  },
  {
   "fieldname": "mit_belegbildern",
   "fieldtype": "Check",
   "label": "Include Voucher Images (Invoice PDFs)",
   "default": "1"
  },
